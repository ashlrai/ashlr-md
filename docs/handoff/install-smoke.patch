diff --git a/.github/workflows/install-smoke.yml b/.github/workflows/install-smoke.yml
new file mode 100644
--- /dev/null
+++ b/.github/workflows/install-smoke.yml
@@ -0,0 +1,79 @@
+name: install smoke
+
+# Suggested hosted smoke for macOS and Windows. This file is not applied.
+# It lives in docs/handoff/install-smoke.patch and must not be copied under
+# .github until someone chooses to. It runs only on pull requests whose
+# paths match below: scripts/install*, the release flow, or OS-specific code.
+
+on:
+  pull_request:
+    types: [opened, synchronize, reopened]
+    paths:
+      - "scripts/install*"
+      - "scripts/ci/release-asset.mjs"
+      - "scripts/ci/release-install.sh"
+      - "scripts/ci/commit-install.sh"
+      - "scripts/release-signature-check/**"
+      - ".github/workflows/release.yml"
+      - ".github/workflows/release-assemble.yml"
+      - ".github/workflows/release-assemble-dispatch.yml"
+      - ".github/workflows/release-publish.yml"
+      - "src-tauri/tauri.macos.conf.json"
+      - "src-tauri/tauri.windows.conf.json"
+      - "src-tauri/bins/mdopener-afm/**"
+      - "src-tauri/bins/mdopener-setdefault/**"
+      - "scripts/native-qa-windows.py"
+      - "**/*.wxs"
+      - "**/nsis/**"
+
+permissions:
+  contents: read
+
+concurrency:
+  group: install-smoke-${{ github.event.pull_request.number }}
+  cancel-in-progress: true
+
+jobs:
+  macos:
+    name: install smoke (macos)
+    runs-on: macos-latest
+    timeout-minutes: 30
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
+        with:
+          persist-credentials: false
+      - name: Install Rust
+        uses: dtolnay/rust-toolchain@b725eda525362e7cf34af9a7243cac1e3f01a7ec # stable
+        with:
+          toolchain: "1.99.1"
+          components: clippy,rustfmt
+      - name: Install Bun
+        uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2
+        with:
+          bun-version: "1.3.14"
+      - name: Probe CPU and Command Line Tools, then install the CLI
+        run: |
+          set -euo pipefail
+          uname -m
+          xcode-select -p
+          SKIP_APP_BUILD=1 bash scripts/install.sh
+          command -v mdopen
+          mdopen --version
+
+  windows:
+    name: install smoke (windows)
+    runs-on: windows-latest
+    timeout-minutes: 30
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
+        with:
+          persist-credentials: false
+      - name: Download the latest release and install it silently
+        shell: pwsh
+        run: pwsh -NoProfile -File scripts/install.ps1
+      - name: Confirm mdopen from the per-user install
+        shell: pwsh
+        run: |
+          $exe = Join-Path $env:LOCALAPPDATA "Ashlr MD\mdopen.exe"
+          if (-not (Test-Path $exe)) { throw "mdopen.exe was not installed at $exe" }
+          & $exe --version
