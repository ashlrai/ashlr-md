{
  "schemaVersion": 1,
  "mode": "replace-detected",
  "commands": [
    {
      "id": "root-typecheck",
      "kind": "typecheck",
      "cmd": ["bun", "run", "typecheck"],
      "cwd": ".",
      "timeoutMs": 180000,
      "required": true,
      "profiles": ["quick", "merge"]
    },
    {
      "id": "root-test",
      "kind": "test",
      "cmd": ["bun", "run", "test"],
      "cwd": ".",
      "timeoutMs": 300000,
      "required": true,
      "profiles": ["merge"]
    },
    {
      "id": "root-build",
      "kind": "build",
      "cmd": ["bun", "run", "build"],
      "cwd": ".",
      "timeoutMs": 300000,
      "required": true,
      "profiles": ["merge"]
    },
    {
      "id": "rust-sidecars-check",
      "kind": "typecheck",
      "cmd": ["cargo", "check", "-p", "mdopener-mcp", "-p", "mdopen"],
      "cwd": "src-tauri",
      "timeoutMs": 300000,
      "required": true,
      "profiles": ["merge"]
    },
    {
      "id": "rust-mcp-test",
      "kind": "test",
      "cmd": ["cargo", "test", "-p", "mdopener-mcp"],
      "cwd": "src-tauri",
      "timeoutMs": 300000,
      "required": true,
      "profiles": ["merge"]
    }
  ]
}
