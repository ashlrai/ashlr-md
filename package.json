{
  "name": "md-opener",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "check:crypto": "node --test scripts/check-crypto.test.mjs && node scripts/check-crypto.mjs",
    "check:doc-links": "node --test scripts/check-doc-links.test.mjs && node scripts/check-doc-links.mjs",
    "resolve-conflicts": "node scripts/resolve-conflicts.mjs",
    "test:conflicts": "node --test scripts/resolve-conflicts.test.mjs",
    "test:select": "node --test scripts/ci/select.test.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "format": "biome format --write src",
    "fresh:sync": "node scripts/freshness/sync.mjs",
    "fresh:check": "node scripts/freshness/check.mjs",
    "test:freshness": "node --test scripts/freshness/freshness.test.mjs",
    "test:dispatch": "node --test scripts/ci/validate-dispatch.test.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@milkdown/crepe": "7.21.2",
    "@milkdown/kit": "7.21.2",
    "@milkdown/react": "7.21.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "decode-named-character-reference": "^1.3.0",
    "dompurify": "^3.4.8",
    "epub-gen-memory": "^1.1.2",
    "github-slugger": "^2.0.0",
    "html-to-docx": "^1.8.0",
    "katex": "^0.17.0",
    "mermaid": "^11.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.2.0",
    "unist-util-visit": "^5.1.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "2.1.9",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "happy-dom": "^20.10.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "2"
  }
}
